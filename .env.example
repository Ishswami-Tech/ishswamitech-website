# ---------------------------------------------------------------------------
# Contact form storage
#
# Pick ONE delivery method:
#   A) Apps Script  — set CONTACT_GOOGLE_APPS_SCRIPT_URL only.
#   B) Sheets API   — set CONTACT_GOOGLE_SHEET_ID + the service account vars.
# If neither is configured the contact endpoint returns a 500 and logs why.
# ---------------------------------------------------------------------------

# A) Apps Script web app endpoint
CONTACT_GOOGLE_APPS_SCRIPT_URL=

# B) Google Sheets API
CONTACT_GOOGLE_SHEET_ID=your-google-sheet-id
CONTACT_GOOGLE_SHEET_RANGE=A:H
CONTACT_GOOGLE_SHEET_HEADER_RANGE=A1:H1
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Payment bridge
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BACKEND_URL=https://backend-service-v1.ishswami.in
NEXT_PUBLIC_VIDDHAKARMA_URL=https://www.viddhakarma.com
NEXT_PUBLIC_RAZORPAY_KEY_ID=

SENTRY_DSN=your_sentry_dsn_here
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here